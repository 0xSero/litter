+    #[cfg(target_os = "ios")]
+    async fn exec_command_ios(
+        &self,
+        request: &ExecCommandRequest,
+        cwd: PathUri,
+        context: &UnifiedExecContext,
+    ) -> Result<ExecCommandToolOutput, UnifiedExecError> {
+        use crate::exec::IOS_EXEC_HOOK;
+        use crate::exec::IOS_STREAMING_EXEC_HOOK;
+        use crate::exec::IosExecOutputHandler;
+        use crate::exec::MOBILE_EXEC_PREFLIGHT;
+
+        let event_ctx = ToolEventCtx::new(
+            context.session.as_ref(),
+            context.step_context.turn.as_ref(),
+            &context.step_context.settings.model_info,
+            &context.call_id,
+            None,
+        );
+        let emitter = ToolEmitter::unified_exec(
+            &request.command,
+            cwd.clone(),
+            ExecCommandSource::UnifiedExecStartup,
+            Some(request.process_id.to_string()),
+            None,
+        );
+        emitter.emit(event_ctx, ToolEventStage::Begin).await;
+
+        let env = create_env(
+            request.turn_environment.shell_environment_policy(),
+            Some(context.session.thread_id),
+        );
+        let start = Instant::now();
+        let transcript = Arc::new(tokio::sync::Mutex::new(HeadTailBuffer::default()));
+        let (chunk_tx, mut chunk_rx) = tokio::sync::mpsc::unbounded_channel::<Vec<u8>>();
+        let output_handler: IosExecOutputHandler = Arc::new(move |chunk| {
+            let _ = chunk_tx.send(chunk);
+        });
+        let local_cwd = cwd
+            .to_abs_path()
+            .map_err(|error| UnifiedExecError::process_failed(error.to_string()))?;
+        let mut join = tokio::task::spawn_blocking({
+            let mut command = request.command.clone();
+            let cwd = local_cwd;
+            let output_handler = Arc::clone(&output_handler);
+            move || {
+                if let Some(preflight) = MOBILE_EXEC_PREFLIGHT.get() {
+                    preflight(&mut command);
+                }
+                if let Some(streaming_hook) = IOS_STREAMING_EXEC_HOOK.get() {
+                    streaming_hook(&command, &cwd, &env, None, output_handler)
+                } else {
+                    IOS_EXEC_HOOK
+                        .get()
+                        .map(|f| f(&command, &cwd, &env, None))
+                        .unwrap_or((-1, b"no iOS exec hook registered\n".to_vec()))
+                }
+            }
+        });
+
+        let mut output = Buffer::for_mobile(context, Arc::clone(&transcript));
+        let (exit_code, raw_output) = loop {
+            tokio::select! {
+                Some(chunk) = chunk_rx.recv() => output.push(chunk).await,
+                result = &mut join => {
+                    break result.unwrap_or((-1, b"spawn_blocking panicked\n".to_vec()));
+                }
+            }
+        };
+        while let Ok(chunk) = chunk_rx.try_recv() {
+            output.push(chunk).await;
+        }
+        output.finish().await;
+        let wall_time = Instant::now().saturating_duration_since(start);
+
+        let text = String::from_utf8_lossy(&raw_output).to_string();
+        emit_exec_end_for_unified_exec(
+            Arc::clone(&context.session),
+            Arc::clone(&context.step_context.turn),
+            Arc::clone(&context.step_context.settings.model_info),
+            context.call_id.clone(),
+            request.command.clone(),
+            cwd,
+            Some(request.process_id.to_string()),
+            None,
+            transcript,
+            text.clone(),
+            exit_code,
+            wall_time,
+            false,
+        )
+        .await;
+
+        self.release_process_id(request.process_id).await;
+
+        let original_token_count =
+            usize::try_from(approx_tokens_from_byte_count(raw_output.len())).unwrap_or(usize::MAX);
+        Ok(ExecCommandToolOutput {
+            event_call_id: context.call_id.clone(),
+            chunk_id: generate_chunk_id(),
+            wall_time,
+            raw_output,
+            truncation_policy: context
+                .step_context
+                .settings
+                .model_info
+                .truncation_policy
+                .into(),
+            output_omitted_bytes: None,
+            max_output_tokens: request.max_output_tokens,
+            process_id: None,
+            exit_code: Some(exit_code),
+            original_token_count: Some(original_token_count),
+            hook_command: Some(request.hook_command.clone()),
+        })
+    }
