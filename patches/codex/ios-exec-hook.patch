+/// Register the iOS exec hook before starting the server.
+#[cfg(target_os = "ios")]
+pub fn set_ios_exec_hook(
+    f: fn(&[String], &Path, &HashMap<String, String>, Option<u64>) -> (i32, Vec<u8>),
+) {
